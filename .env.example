# Copy this file to .env (not .env.local — see README) and fill in real
# values. Nothing in this file is committed with real secrets — every
# integration below has a working demo fallback when its variables are left
# unset, so the app runs fully out of the box with `npm install && npm run
# dev` and upgrades itself the moment real credentials are added, with no
# code changes required. NEVER commit a .env file with real values — it is
# already covered by .gitignore, keep it that way.

# ---------------------------------------------------------------------------
# Database — self-hosted PostgreSQL (no managed/cloud provider, no Supabase)
# ---------------------------------------------------------------------------
# Standard libpq connection string, e.g.:
#   postgresql://holotech_app:YOUR_PASSWORD@127.0.0.1:5432/holotech
# The role/database are created by scripts/create-db-role.sql — see the
# README's "Налаштування PostgreSQL на VPS" section. Postgres should be
# listening on localhost (127.0.0.1) or a private network only — never a
# public IP — so this connection never crosses the public internet.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Product image storage — local disk on this VPS
# ---------------------------------------------------------------------------
# Directory product photos are written to/read from. Keep it OUTSIDE the
# Next.js `public/` folder (files are served through
# src/app/api/storage/products/[filename], never directly by the web
# server) and outside git (already in .gitignore). Relative paths resolve
# against the process's working directory. Absolute path recommended in
# production, e.g. /var/lib/holotech/storage/products.
PRODUCT_IMAGES_DIR=./storage/products

# ---------------------------------------------------------------------------
# Admin panel auth
# ---------------------------------------------------------------------------
# Random 32+ byte secret used to sign the admin session cookie (HMAC).
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# One-time secret for POST /api/admin/bootstrap, which creates your first
# administrator account without hand-writing SQL. Leave this UNSET to keep
# that endpoint disabled; set it only while you're about to run the
# bootstrap request once, then remove it (or change it) afterwards so the
# endpoint can't be called again. Generate one with: openssl rand -hex 24
ADMIN_BOOTSTRAP_SECRET=

# ---------------------------------------------------------------------------
# Telegram bot (order notifications to the manager/group)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather, then message it (or add it to your group) and
# call https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret Telegram must present on webhook calls, and the cron caller
# must present on /api/cron/reminders AND /api/cron/nova-poshta-sync —
# prevents randoms from hitting these endpoints. Generate one with:
#   openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------------------
# Nova Poshta (city / branch lookup for delivery)
# ---------------------------------------------------------------------------
# NOT used by the city/branch directory feature, and not required for it —
# Address.getCities / Address.getWarehouses / Address.getWarehouseTypes don't
# need a key. That directory is imported into our own PostgreSQL by
# src/lib/novaposhta-import.ts (see README "Настройка Nova Poshta") and served
# from there via /api/nova-poshta/*, which never calls Nova Poshta directly.
# Leave this empty unless/until a future feature that genuinely requires
# authorization (delivery-cost calculation, waybill/TTN creation, ...) is
# added — server-side only either way, never exposed to the browser.
NOVA_POSHTA_API_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://holotech.store
