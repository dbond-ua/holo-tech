# HoloTech production deploy — configuration
#
# Copy this to deploy.env on the VPS (next to deploy.sh) and fill in what you
# know. Leave anything unknown blank — deploy.sh handles blanks safely (it
# either skips that piece and tells you what to do, or generates a secret
# for you). This file never needs to leave the VPS and is never read by me.
#
#   cp deploy.env.example deploy.env
#   nano deploy.env
#   sudo bash deploy.sh

# ---------------------------------------------------------------------------
# Where the project lives on this VPS (you scp/rsync it here BEFORE running
# deploy.sh — see the instructions you were given alongside this file).
# ---------------------------------------------------------------------------
PROJECT_DIR=/var/www/holotech

# ---------------------------------------------------------------------------
# Domain — leave DOMAIN empty if you don't have one pointed at this VPS yet.
# The site will still be deployed and reachable over plain HTTP by IP;
# deploy.sh will tell you exactly what to do once you have a domain.
# ---------------------------------------------------------------------------
DOMAIN=
LETSENCRYPT_EMAIL=

# ---------------------------------------------------------------------------
# First administrator account. If both are filled in, deploy.sh creates this
# account for you via the app's own one-time bootstrap endpoint (never by
# hand-writing SQL) and immediately disables that endpoint again. The
# password is written ONLY to /root/holotech-admin-credentials.txt on the
# VPS (root-only, mode 600) — it is never printed to this script's log and
# never sent back to me. Leave ADMIN_PASSWORD empty to have deploy.sh
# generate a strong random one for you.
# ---------------------------------------------------------------------------
ADMIN_NAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=qwerty123

# ---------------------------------------------------------------------------
# Telegram (order notifications). Leave BOTH empty to skip — deploy.sh will
# not touch the integration and will tell you exactly which two values to
# fill in later and re-run.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Rarely need to change these.
# ---------------------------------------------------------------------------
APP_PORT=3000
DB_NAME=holotech
DB_APP_USER=holotech_app
BACKUP_DIR=/var/backups/holotech
